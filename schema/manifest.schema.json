{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:software-identity-catalog:schema:manifest",
  "title": "Release manifest",
  "description": "manifest.json of a release (docs/design.md section 5). Consumers check every listed file's bytes and SHA-256 before use.",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "created", "files", "sources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$"},
    "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "required": ["name", "bytes", "sha256", "license", "sources"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^catalog-[a-z0-9-]+\\.json$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "license": {"description": "SPDX license expression; NOASSERTION when the source publishes none.", "type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "description": "One source as this build used it. `revision` is copied from tools/sources.json and describes the records in the repository; on a failed import those are the previous records.",
      "type": "object",
      "required": ["status", "records", "entriesSha256"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["ok", "failed"]},
        "records": {"type": "integer", "minimum": 0},
        "entriesSha256": {"$ref": "#/$defs/sha256"},
        "url": {"type": "string", "pattern": "^https://"},
        "revision": {"type": "object"}
      }
    }
  }
}
